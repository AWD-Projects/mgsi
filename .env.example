# Base de datos (la misma que usa el portal de administración mg-portal)
MONGODB_URI=
# Opcional: nombre de la base si no viene en la URI
MONGODB_DB=

# Correo del formulario de contacto (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_TO=

# Sitio
NEXT_PUBLIC_SITE_URL=https://mgsi.netlify.app
# Opcional: por defecto 525555342493 (55 5534 2493). Solo dígitos con lada de país
NEXT_PUBLIC_WHATSAPP_NUMBER=525555342493
# Opcional: código de verificación de Google Search Console
NEXT_PUBLIC_GSC_VERIFICATION=
# Solo en previews/dev: "true" para bloquear indexación
NEXT_PUBLIC_NOINDEX=
